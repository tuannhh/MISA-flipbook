# Copy thanh .env cung thu muc va dien gia tri that.
# KHONG commit file .env that vao git (da khai bao trong .gitignore).

POSTGRES_USER=misa_admin
POSTGRES_PASSWORD=changeme-strong-password
POSTGRES_DB=misa_flipbook

# Mat khai cho role runtime app_user (khong phai superuser) - dung boi API va migration runner.
APP_DB_PASSWORD=changeme-app-user-password

# Ky JWT cho API (HS256). Doi that su khi trien khai, >= 32 ky tu ngau nhien.
JWT_SECRET=changeme-jwt-secret-please-rotate
JWT_EXPIRES_IN_SECONDS=28800

# Shared secret giua dispatcher va pdf-worker (khong lo ra ngoai internet).
INTERNAL_API_TOKEN=changeme-internal-token

# Gioi han kich thuoc PDF upload (bytes) va version pipeline dung de tao idempotency_key cho job.
PDF_MAX_BYTES=209715200
PDF_PIPELINE_VERSION=v1

# Dispatcher: khoang thoi gian poll bang jobs (ms) va so job xu ly song song.
DISPATCHER_POLL_INTERVAL_MS=2000
DISPATCHER_CONCURRENCY=2
