# Copy thanh .env cung thu muc va dien gia tri that.
# KHONG commit file .env that vao git (da khai bao trong .gitignore).

POSTGRES_USER=misa_admin
POSTGRES_PASSWORD=changeme-strong-password
POSTGRES_DB=misa_flipbook

# Mat khai cho role runtime app_user (khong phai superuser) - dung boi API va migration runner.
APP_DB_PASSWORD=changeme-app-user-password

# Ky JWT cho API (HS256). Doi that su khi trien khai, >= 32 ky tu ngau nhien.
JWT_SECRET=changeme-jwt-secret-please-rotate
JWT_EXPIRES_IN_SECONDS=28800

# Shared secret giua worker-convert va pdf-worker (khong lo ra ngoai internet).
INTERNAL_API_TOKEN=changeme-internal-token

# Gioi han kich thuoc PDF upload (bytes) va version pipeline dung de tao idempotency_key cho job.
PDF_MAX_BYTES=209715200
PDF_PIPELINE_VERSION=v1

# Tenant quota includes the source PDF and generated assets. The worker reconciles
# physical bytes separately and only deletes stale, unreferenced attempt folders.
TENANT_SOURCE_BYTES=10737418240
TENANT_STORAGE_BYTES=53687091200
TENANT_PENDING_JOBS=20
STORAGE_ORPHAN_RETENTION_SECONDS=86400
STORAGE_RECONCILE_INTERVAL_MS=21600000

# Rate limiting: Redis is the shared authority. If it is briefly unavailable, API
# falls back to a bounded in-process counter instead of allowing brute-force traffic.
RATE_LIMIT_COMMAND_TIMEOUT_MS=500
RATE_LIMIT_CONNECT_TIMEOUT_MS=500
RATE_LIMIT_FALLBACK_MAX_KEYS=10000
# Store this separately from JWT_SECRET in production. It HMACs email/IP before
# using them as Redis keys, so rate-limit infrastructure does not retain raw PII.
RATE_LIMIT_KEY_SECRET=
LOGIN_MAX_ATTEMPTS=10
LOGIN_IP_MAX_ATTEMPTS=30
LOGIN_WINDOW_SECONDS=900
BOOK_PASSWORD_MAX_ATTEMPTS=8
BOOK_PASSWORD_IP_MAX_ATTEMPTS=32
BOOK_PASSWORD_LOCKOUT_MINUTES=15

# Browser vao proxy cung origin voi API (/api); CORS chi can khi co mot origin khac.
CORS_ORIGIN=http://localhost:8080

# Chi bat >0 khi API KHONG mo port truc tiep va chi nhan request qua proxy da duoc
# chot. Docker pilot co dung 1 hop Nginx; deploy direct dat 0.
TRUST_PROXY_HOPS=1

# Base cua API trong bundle FE. `/api` di qua bundled proxy cung origin, nen khong
# phai hard-code hostname; khi FE chay khong qua proxy, dat URL tuyet doi cua API.
WEB_PUBLIC_API_BASE_URL=/api

# P6 (khao sat Social API): Facebook App ID THAT de dung Facebook Share Dialog qua SDK
# (khac ban rut gon sharer.php khong can app). PHAI tu tao tai developers.facebook.com
# (Claude khong the tao app/tai khoan thay ban) - loai app "Consumer", chi can bat tinh
# nang "Facebook Login for Business" hoac don gian la lay App ID mac dinh khi tao app moi,
# KHONG can App Review vi Share Dialog la tinh nang cong khai. De trong = FE tu dong
# fallback ve link sharer.php (van hoat dong binh thuong, khong bi chan).
WEB_PUBLIC_FACEBOOK_APP_ID=

# dispatcher (chi claim job, xem apps/dispatcher): khoang thoi gian poll bang jobs (ms),
# khoang thoi gian chay lai reconciler (ms), so lan retry toi da cho 1 job.
DISPATCHER_POLL_INTERVAL_MS=2000
DISPATCHER_RECONCILE_INTERVAL_MS=60000
DISPATCHER_JOB_ATTEMPTS=3

# worker-convert (xu ly job that su, xem apps/worker-convert): so job xu ly song song.
WORKER_CONVERT_CONCURRENCY=2
